{
  "schemaVersion": "agentdesktop.ai/1",
  "status": "PROPOSED_CONTRACT_NOT_PRODUCTION",
  "transport": {
    "macOS": "existing owner-only Unix socket control.sock",
    "windows": "current-user-ACL named pipe",
    "framing": "one request JSON line and one response JSON line per connection",
    "maxFrameBytes": 1048576,
    "countIncludesNewline": true
  },
  "schemaIds": {
    "domain": "https://schemas.agentdesktop.invalid/ai-gui/v1/domain.schema.json",
    "rpc": "https://schemas.agentdesktop.invalid/ai-gui/v1/rpc.schema.json"
  },
  "requestRef": "rpc.schema.json#/$defs/Request",
  "responseRef": "rpc.schema.json#/$defs/Response",
  "operations": [
    {
      "command": "runtime.capabilities",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/runtime_capabilities_params",
      "resultRef": "rpc.schema.json#/$defs/runtime_capabilities_result",
      "note": ""
    },
    {
      "command": "ai.connections.list",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_list_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_list_result",
      "note": ""
    },
    {
      "command": "ai.connections.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_get_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_get_result",
      "note": ""
    },
    {
      "command": "ai.connections.create",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_create_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_create_result",
      "note": "Secret is write-only. Returns credentialRef only."
    },
    {
      "command": "ai.connections.update",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_update_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_update_result",
      "note": "Metadata only; absent secret is unchanged. Rotate through ai.credentials.rotate."
    },
    {
      "command": "ai.connections.disable",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_disable_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_disable_result",
      "note": "Prevents new bindings; does not revoke active immutable bindings."
    },
    {
      "command": "ai.connections.delete",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_connections_delete_params",
      "resultRef": "rpc.schema.json#/$defs/ai_connections_delete_result",
      "note": "Soft tombstone. RESOURCE_IN_USE for referenced model profiles or active runs; no cascade."
    },
    {
      "command": "ai.credentials.rotate",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_credentials_rotate_params",
      "resultRef": "rpc.schema.json#/$defs/ai_credentials_rotate_result",
      "note": "Creates new credential identity, revokes old identity; active old bindings must stop further inference. No secret read operation."
    },
    {
      "command": "ai.models.list",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_models_list_params",
      "resultRef": "rpc.schema.json#/$defs/ai_models_list_result",
      "note": ""
    },
    {
      "command": "ai.models.refresh",
      "mutation": true,
      "asynchronous": true,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_models_refresh_params",
      "resultRef": "rpc.schema.json#/$defs/ai_models_refresh_result",
      "note": "Returns operationId; catalog metadata does not verify GUI capability."
    },
    {
      "command": "ai.modelProfiles.list",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_list_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_list_result",
      "note": ""
    },
    {
      "command": "ai.modelProfiles.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_get_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_get_result",
      "note": ""
    },
    {
      "command": "ai.modelProfiles.create",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_create_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_create_result",
      "note": "Capability evidence is server-owned; untested profile starts unknown."
    },
    {
      "command": "ai.modelProfiles.update",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_update_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_update_result",
      "note": "Changed endpoint/model/options invalidate affected capability evidence for new revision."
    },
    {
      "command": "ai.modelProfiles.disable",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_disable_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_disable_result",
      "note": ""
    },
    {
      "command": "ai.modelProfiles.delete",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_modelProfiles_delete_params",
      "resultRef": "rpc.schema.json#/$defs/ai_modelProfiles_delete_result",
      "note": "RESOURCE_IN_USE for GUI profile references or active runs; no cascade."
    },
    {
      "command": "ai.profiles.list",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_list_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_list_result",
      "note": ""
    },
    {
      "command": "ai.profiles.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_get_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_get_result",
      "note": ""
    },
    {
      "command": "ai.profiles.create",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_create_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_create_result",
      "note": "fixture_json_v1 permitted only in explicit developer/test mode."
    },
    {
      "command": "ai.profiles.update",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_update_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_update_result",
      "note": ""
    },
    {
      "command": "ai.profiles.disable",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_disable_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_disable_result",
      "note": "Cannot become a new run binding or fallback candidate; default pointer retained but unusable until changed/re-enabled."
    },
    {
      "command": "ai.profiles.delete",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_delete_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_delete_result",
      "note": "RESOURCE_IN_USE for default pointer, fallback references, or active run; no cascade."
    },
    {
      "command": "ai.profiles.default.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_default_get_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_default_get_result",
      "note": ""
    },
    {
      "command": "ai.profiles.setDefault",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_profiles_setDefault_params",
      "resultRef": "rpc.schema.json#/$defs/ai_profiles_setDefault_result",
      "note": "Separate CAS revision for default pointer. Non-null target revision verified; default affects only new runs."
    },
    {
      "command": "ai.tests.start",
      "mutation": true,
      "asynchronous": true,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_tests_start_params",
      "resultRef": "rpc.schema.json#/$defs/ai_tests_start_result",
      "note": "Four-level synthetic capability test; no desktop input. May make billed model requests; idempotency required."
    },
    {
      "command": "ai.operations.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_operations_get_params",
      "resultRef": "rpc.schema.json#/$defs/ai_operations_get_result",
      "note": ""
    },
    {
      "command": "ai.operations.cancel",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/ai_operations_cancel_params",
      "resultRef": "rpc.schema.json#/$defs/ai_operations_cancel_result",
      "note": ""
    },
    {
      "command": "gui.runs.start",
      "mutation": true,
      "asynchronous": true,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/gui_runs_start_params",
      "resultRef": "rpc.schema.json#/$defs/gui_runs_start_result",
      "note": "Omitted profile resolves default atomically. Omitted sessionId creates a run-scoped session only for trusted owner UI/CLI. Verification predicate is required and Runtime-owned. Socket close does not cancel run."
    },
    {
      "command": "gui.runs.get",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/gui_runs_get_params",
      "resultRef": "rpc.schema.json#/$defs/gui_runs_get_result",
      "note": ""
    },
    {
      "command": "gui.runs.cancel",
      "mutation": true,
      "asynchronous": false,
      "requiresIdempotencyKey": true,
      "paramsRef": "rpc.schema.json#/$defs/gui_runs_cancel_params",
      "resultRef": "rpc.schema.json#/$defs/gui_runs_cancel_result",
      "note": "Accepted cancellation is not terminal. Generation invalidates immediately; in-flight input must reconcile before ownership release."
    },
    {
      "command": "gui.runs.events",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/gui_runs_events_params",
      "resultRef": "rpc.schema.json#/$defs/gui_runs_events_result",
      "note": "Sequence strictly monotonic; retry may duplicate events across polls, deduplicate by runId+sequence. Cursor never silently skips."
    },
    {
      "command": "ai.usage.summary",
      "mutation": false,
      "asynchronous": false,
      "requiresIdempotencyKey": false,
      "paramsRef": "rpc.schema.json#/$defs/ai_usage_summary_params",
      "resultRef": "rpc.schema.json#/$defs/ai_usage_summary_result",
      "note": ""
    }
  ]
}
