{
  "apiVersion": "agentdesktop.runtime/1",
  "status": "FROZEN_2026_10_08",
  "transport": {
    "macOS": "owner-only Unix domain socket: the product host serves runtime/1 on one endpoint (runtime.sock today; renamed control.sock when nothing else uses that name); ai.sock is gone (A2)",
    "windows": "current-user named pipe (W1)",
    "framing": "UTF-8 JSON, one message per LF-terminated line; requests on one connection are answered in order",
    "maxFrameBytes": 1048576,
    "countIncludesNewline": true,
    "firstMethod": "runtime.handshake",
    "requestLedger": {
      "key": "caller uid + requestId",
      "digest": "sha256 of canonical {method, context, params}",
      "retentionDays": 7,
      "onRestart": "accepted → unknown"
    },
    "artifacts": {
      "location": "<endpoint dir>/runtime/artifacts, never sent to clients",
      "access": "artifact.show / artifact.read by id; visible to the producing principal and the owner",
      "retentionHours": 24
    },
    "control": {
      "runs": "ADR v2.2: Delegated = external_client/connection_scoped (client connections; control-connection loss stops it); Durable = platform/platform_durable (created inside the Runtime only; no connection ends it)",
      "lease": "one per Desktop, held by one live Run",
      "admission": "runtime.stopAll closes input for all Runs; runtime.enableInput reopens for new Runs only"
    }
  },
  "schema": "runtime.schema.json",
