{
  "name": "ur-approval-rejected",
  "e2eClass": "approval_channel_missing_cancelled",
  "gates": [
    "G2-06",
    "G2-07"
  ],
  "description": "Mock 审批通道缺失后取消（不代表真实审批拒绝）：Run 进入 waiting_approval；runtime/1 还没有 inbox（PR4），ACP 按 capability_missing 处理为拒绝，绝不当作批准；随后用户取消，Run cancelled，没有任何动作发出。编辑器 Ask 模式下的提交前确认被拒绝时则根本不发 unit.run（见服务端测试）。",
  "layer": "fixture: Mock today (URTestRuntime); Real after A6 (lane Q, test copy under /tmp/adt-*)",
  "desktopId": "desk_A",
  "input": {
    "mode": "explore",
    "goal": {
      "description": "打开计算器的「关于计算器」窗口"
    },
    "verification": {
      "all": [
        {
          "kind": "element_text_equals",
          "role": "static_text",
          "text": "关于计算器"
        }
      ]
    },
    "allowedActions": [
      "click",
      "wait"
    ],
    "limits": {
      "maxSteps": 10,
      "maxSeconds": 120
    }
  },
  "runtime": {
    "answer": "accept",
    "phaseAfterAccept": "waiting_approval",
    "onAccept": [
      {
        "type": "run.started",
        "data": {
          "kind": "unit",
          "origin": "agent_hub",
          "ownership": "external_client",
          "lifetime": "connection_scoped",
          "desktopId": "desk_A",
          "sessionId": "sess_A"
        }
      }
    ],
    "trigger": {
      "cancelAfter": "run.started"
    },
    "onTrigger": [
      {
        "type": "stop.accepted",
        "data": {
          "reason": "cancelled",
          "inFlight": false,
          "revision": 2
        }
      },
      {
        "type": "run.quiescent",
        "data": {
          "revision": 3
        }
      },
      {
        "type": "run.ended",
        "data": {
          "phase": "ended",
          "outcome": "cancelled",
          "reason": "cancelled"
        }
      }
    ],
    "final": {
      "outcome": "cancelled",
      "closingReason": "cancelled",
      "unknownActions": 0,
      "verification": "not_run"
    }
  },
  "expect": {
    "submit": "accepted",
    "actionLevels": [],
    "planResult": "结果：已取消",
    "textContains": [
      "任务结束：已取消"
    ],
    "textExcludes": [
      "已验证",
      "\"actionLevel\":\"verified\""
    ],
    "runtimeFinal": {
      "outcome": "cancelled",
      "closingReason": "cancelled"
    },
    "unitRunCalls": 1,
    "cancelCalls": 1,
    "approvalDecisionsSent": 0
  }
}
