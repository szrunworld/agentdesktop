{
  "id": "T12-cancel",
  "cases": [
    "ACP-T12-01",
    "ACP-T12-02",
    "ACP-T12-03"
  ],
  "title": "进行中的一轮被取消：stopReason cancelled，之后 1.5 秒无新工具更新；空闲会话取消无副作用；会话仍可用",
  "requires": [
    "task.slow"
  ],
  "steps": [
    {
      "op": "connect"
    },
    {
      "op": "initialize",
      "expect": {
        "protocolVersionIn": "${SUPPORTED_VERSIONS}"
      }
    },
    {
      "op": "newSession",
      "as": "s1"
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_SLOW}",
      "cancelAfterMs": "${CANCEL_AFTER_MS}",
      "expect": {
        "stopReason": "cancelled",
        "quietAfterMs": 1500
      }
    },
    {
      "op": "cancel",
      "session": "s1"
    },
    {
      "op": "expectAlive",
      "ms": 300
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_ECHO}",
      "timeoutMs": 30000,
      "expect": {
        "stopReason": "end_turn"
      }
    },
    {
      "op": "disconnect"
    },
    {
      "op": "expectExit",
      "withinMs": 5000
    }
  ]
}
