{
  "id": "T02e-error-no-echo",
  "cases": ["ACP-T02-07"],
  "title": "带敏感正文的非法请求：错误回复与 stderr 都不含请求正文",
  "steps": [
    { "op": "connect" },
    { "op": "initialize", "expect": { "protocolVersionIn": "${SUPPORTED_VERSIONS}" } },
    { "op": "newSession", "as": "s1" },
    {
      "op": "raw",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":\"raw-s1\",\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"type\":\"text\",\"text\":\"QTEST-SECRET-A 王小明 13800138000",
      "expect": { "errorCode": -32700 }
    },
    {
      "op": "raw",
      "id": "raw-s2",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":\"raw-s2\",\"method\":\"qtest/no_such_method\",\"params\":{\"text\":\"QTEST-SECRET-B 王小明\"}}",
      "expect": { "errorCode": -32601, "notEchoes": ["QTEST-SECRET-B"] }
    },
    {
      "op": "raw",
      "id": "raw-s3",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":\"raw-s3\",\"method\":\"session/prompt\",\"params\":{\"sessionId\":42,\"prompt\":[{\"type\":\"text\",\"text\":\"QTEST-SECRET-C bob@example.com\"}]}}",
      "expect": { "errorCodeIn": [-32602, -32600], "notEchoes": ["QTEST-SECRET-C"] }
    },
    {
      "op": "raw",
      "id": "raw-s4",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":\"raw-s4\",\"method\":\"session/prompt\",\"params\":{\"sessionId\":\"qtest-no-such-session\",\"prompt\":[{\"type\":\"text\",\"text\":\"QTEST-SECRET-D 候选人\"}]}}",
      "expect": { "ok": false, "waitMs": 10000, "notEchoes": ["QTEST-SECRET-D"] }
    },
    {
      "op": "raw",
      "id": "raw-s5",
      "line": "{\"jsonrpc\":\"2.0\",\"id\":\"raw-s5\",\"method\":\"session/prompt\",\"params\":{\"sessionId\":\"qtest-no-such-session\",\"prompt\":[{\"type\":\"qtest_weird_block\",\"secret\":\"QTEST-SECRET-E\"}]}}",
      "expect": { "ok": false, "waitMs": 10000, "notEchoes": ["QTEST-SECRET-E"] }
    },
    { "op": "expectAlive", "ms": 300 },
    { "op": "assert", "noFrameContains": ["QTEST-SECRET", "13800138000", "bob@example.com"] },
    { "op": "disconnect" },
    { "op": "expectExit", "withinMs": 5000 }
  ]
}
