{
  "id": "SceneB-scoped-disconnect",
  "cases": [
    "ACP-P2B-01",
    "ACP-P2B-02"
  ],
  "title": "场景 B：等待审批时编辑器断开，动作不执行；重连加载后不自动继续、不补发审批",
  "requires": [
    "approval",
    "session.load"
  ],
  "steps": [
    {
      "op": "connect"
    },
    {
      "op": "initialize",
      "expect": {
        "protocolVersionIn": "${SUPPORTED_VERSIONS}"
      }
    },
    {
      "op": "newSession",
      "as": "s1"
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_ACT}",
      "permission": "hang",
      "disconnectAfterMs": "${DISCONNECT_AFTER_MS}",
      "timeoutMs": 30000,
      "expect": {
        "stopReasonIn": [
          "disconnected"
        ],
        "permissionRequested": true
      }
    },
    {
      "op": "expectExit",
      "withinMs": 5000
    },
    {
      "op": "mark",
      "name": "afterExit"
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "connect"
    },
    {
      "op": "initialize",
      "expect": {
        "protocolVersionIn": "${SUPPORTED_VERSIONS}"
      }
    },
    {
      "op": "resume",
      "session": "s1",
      "method": "load",
      "expect": {
        "ok": true
      }
    },
    {
      "op": "wait",
      "ms": 2000
    },
    {
      "op": "assert",
      "noNewToolCallsSince": "afterExit",
      "toolCallsNotCompletedSince": "afterExit"
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_ECHO}",
      "expect": {
        "stopReason": "end_turn",
        "permissionRequested": false
      }
    },
    {
      "op": "assert",
      "toolCallsNotCompletedSince": "afterExit"
    },
    {
      "op": "disconnect"
    },
    {
      "op": "expectExit",
      "withinMs": 5000
    }
  ]
}
