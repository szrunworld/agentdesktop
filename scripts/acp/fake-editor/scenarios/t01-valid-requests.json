{
  "id": "T01-valid-requests",
  "cases": [
    "ACP-T01-01",
    "ACP-T01-02",
    "ACP-T01-03"
  ],
  "title": "合法的 initialize / session/new / session/prompt 正常处理，连续两轮都结束于 end_turn",
  "steps": [
    {
      "op": "connect"
    },
    {
      "op": "initialize",
      "expect": {
        "protocolVersionIn": "${SUPPORTED_VERSIONS}"
      }
    },
    {
      "op": "newSession",
      "as": "s1"
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_ECHO}",
      "expect": {
        "stopReason": "end_turn",
        "updatesInclude": [
          "agent_message_chunk"
        ],
        "textIncludes": [
          "${ECHO_TEXT}"
        ]
      }
    },
    {
      "op": "prompt",
      "session": "s1",
      "text": "${PROMPT_ECHO}",
      "expect": {
        "stopReason": "end_turn",
        "textIncludes": [
          "${ECHO_TEXT}"
        ]
      }
    },
    {
      "op": "disconnect"
    },
    {
      "op": "expectExit",
      "withinMs": 5000
    }
  ]
}
